# Database Configuration
# Format: mysql://user:password@host:port/database
# Change credentials/host for production environments
DATABASE_URL="mysql://root:Ak@j023@localhost:3306/archivages"

# JWT Configuration
# JWT_SECRET: Secret key used to sign JWT access tokens
# Must be a strong, random string in production
JWT_SECRET="super-secret-jwt-key-change-in-production"

# JWT_EXPIRES_IN: TTL for access tokens (e.g., "15m", "30m", "1h")
JWT_EXPIRES_IN="15m"

# JWT_REFRESH_SECRET: Secret key used to sign JWT refresh tokens
# Must be different from JWT_SECRET for security
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"

# JWT_REFRESH_EXPIRES_IN: TTL for refresh tokens (e.g., "7d", "30d")
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
# PORT: Backend server port (default: 3000)
PORT=3000

# Frontend Configuration
# FRONTEND_URL: Frontend application URL for CORS and password reset links
# Used in:
#   - CORS origin configuration (main.ts)
#   - Password reset email link generation (auth.service.ts)
# Example: "http://localhost:5173" for development
#          "https://app.example.com" for production
FRONTEND_URL="http://localhost:5173"

# Optional: Environment Mode
# NODE_ENV: Set to 'production', 'development', or 'test'
# NODE_ENV="development"

# Optional: Logging Configuration
# LOG_LEVEL: Set logging level ('debug', 'info', 'warn', 'error')
# LOG_LEVEL="debug"

