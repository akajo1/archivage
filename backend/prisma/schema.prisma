generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


enum ConfidentialityLevel {
  public
  interne
  confidentiel
  secret
}

enum BadgeName {
  critique
  normal
  faible
}

model User {
  id                   String     @id @default(uuid())
  name                 String
  email                String     @unique
  password             String
  role                 String     @default("user")
  mustChangePassword   Boolean    @default(false) @map("must_change_password")
  documents            Document[]
  passwordResetToken   String?    @map("password_reset_token")
  passwordResetExpiry  DateTime?  @map("password_reset_expiry")
  passwordResetRequestedAt DateTime? @map("password_reset_requested_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Badge {
  id        String     @id @default(uuid())
  name      BadgeName  @unique
  color     String
  documents Document[]
  permissions RolePermission[]

  @@map("badges")
}

model Confidentiality {
  id        String               @id @default(uuid())
  level     ConfidentialityLevel @unique
  documents Document[]
  permissions RolePermission[]

  @@map("confidentialities")
}

model Document {
  id                String               @id @default(uuid())
  title             String
  reference         String?
  description       String?              @db.Text
  content           String?              @db.LongText
  fileUrl           String?              @map("file_url")
  createdAt         DateTime             @default(now()) @map("created_at")
  createdBy         User                 @relation(fields: [createdById], references: [id])
  createdById       String               @map("created_by")
  badge             Badge                @relation(fields: [badgeId], references: [id])
  badgeId           String               @map("badge_id")
  confidentiality   Confidentiality      @relation(fields: [confidentialityId], references: [id])
  confidentialityId String               @map("confidentiality_id")
  attachments       DocumentAttachment[]

  @@map("documents")
}

model DocumentAttachment {
  id         String   @id @default(uuid())
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  fileSize   Int?     @map("file_size")
  mimeType   String?  @map("mime_type")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_attachments")
}

model AppRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_roles")
}

model RolePermission {
  id                String            @id @default(uuid())
  role              String            @unique
  canRead           Boolean           @default(true) @map("can_read")
  canCreate         Boolean           @default(false) @map("can_create")
  canEdit           Boolean           @default(false) @map("can_edit")
  badges            Badge[]
  confidentialities Confidentiality[]
  featurePermissions RoleFeaturePermission[]

  @@map("role_permissions")
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entity      String?
  entityId    String?  @map("entity_id")
  entityLabel String?  @map("entity_label")
  userId      String?  @map("user_id")
  userName    String?  @map("user_name")
  userRole    String?  @map("user_role")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RoleFeaturePermission {
  id               String         @id @default(uuid())
  feature          String
  canRead          Boolean        @default(false) @map("can_read")
  canCreate        Boolean        @default(false) @map("can_create")
  canEdit          Boolean        @default(false) @map("can_edit")
  canDelete        Boolean        @default(false) @map("can_delete")
  canSearch        Boolean        @default(false) @map("can_search")
  rolePermission   RolePermission @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)
  rolePermissionId String         @map("role_permission_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([rolePermissionId, feature])
  @@index([feature])
  @@map("role_feature_permissions")
}

