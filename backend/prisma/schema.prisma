generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ConfidentialityLevel {
  public
  interne
  confidentiel
  secret
}

enum BadgeName {
  critique
  normal
  faible
}

enum DocumentStatus {
  draft
  received
  in_review
  validated
  archived
  courrier_prepared
  courrier_sent
}

enum MailRoutingStatus {
  pending
  in_review
  forwarded
  intervening
  awaiting_verification
  verified
  rejected
  returned
  completed
}

enum MailActionType {
  forward
  add_cc
  assign
  comment
  verify
  reject
  return_to_sender
  mark_complete
  archive
}

enum ParticipantRole {
  receiver
  assignee
  reviewer
  approver
  cc
  observer
}

model User {
  id                            String     @id @default(uuid())
  name                          String
  email                         String     @unique
  password                      String
  role                          String     @default("user")
  mustChangePassword            Boolean    @default(false) @map("must_change_password")
  departmentId                  String?    @map("department_id")
  department                    Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])
  departmentChief               Department? @relation("DepartmentChief")
  documents                     Document[]
  mailRoutingsInitiated         MailRouting[] @relation("routing_initiated")
  mailRoutingsAssigned          MailRouting[] @relation("routing_assignee")
  mailParticipants              MailParticipant[]
  mailRoutingActions            MailRoutingAction[]
  mailRoutingActionsAsTarget    MailRoutingAction[] @relation("action_target")
  mailComments                  MailComment[]
  mailAuditTrails               MailAuditTrail[]
  passwordResetToken            String?    @map("password_reset_token")
  passwordResetExpiry           DateTime?  @map("password_reset_expiry")
  passwordResetRequestedAt      DateTime?  @map("password_reset_requested_at")
  createdAt                     DateTime   @default(now()) @map("created_at")
  updatedAt                     DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  chiefId   String?  @unique @map("chief_id")
  chief     User?    @relation("DepartmentChief", fields: [chiefId], references: [id])
  users     User[]   @relation("DepartmentUsers")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model Badge {
  id        String     @id @default(uuid())
  name      BadgeName  @unique
  color     String
  documents Document[]
  permissions RolePermission[]

  @@map("badges")
}

model Confidentiality {
  id        String               @id @default(uuid())
  level     ConfidentialityLevel @unique
  documents Document[]
  permissions RolePermission[]

  @@map("confidentialities")
}

model Document {
  id                   String               @id @default(uuid())
  title                String
  reference            String?
  description          String?              @db.Text
  content              String?              @db.LongText
  fileUrl              String?              @map("file_url")
  status               DocumentStatus       @default(draft)
  documentType         String?              @map("document_type")
  senderDepartment     String?              @map("sender_department")
  senderName           String?              @map("sender_name")
  receiptDate          DateTime?            @map("receipt_date")
  registrationNumber   String?              @unique @map("registration_number")
  createdAt            DateTime             @default(now()) @map("created_at")
  createdBy            User                 @relation(fields: [createdById], references: [id])
  createdById          String               @map("created_by")
  badge                Badge                @relation(fields: [badgeId], references: [id])
  badgeId              String               @map("badge_id")
  confidentiality      Confidentiality      @relation(fields: [confidentialityId], references: [id])
  confidentialityId    String               @map("confidentiality_id")
  attachments          DocumentAttachment[]
  mailRoutings         MailRouting[]
  comments             MailComment[]

  @@map("documents")
}

model DocumentAttachment {
  id         String   @id @default(uuid())
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  fileSize   Int?     @map("file_size")
  mimeType   String?  @map("mime_type")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_attachments")
}

model MailRouting {
  id                String   @id @default(uuid())
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId        String   @map("document_id")
  status            MailRoutingStatus @default(pending)
  initiatedBy       User     @relation("routing_initiated", fields: [initiatedById], references: [id])
  initiatedById     String   @map("initiated_by_id")
  currentAssignee   User?    @relation("routing_assignee", fields: [currentAssigneeId], references: [id])
  currentAssigneeId String?  @map("current_assignee_id")
  dueDate           DateTime? @map("due_date")
  notes             String?  @db.Text
  participants      MailParticipant[]
  actions           MailRoutingAction[]
  comments          MailComment[]
  auditTrail        MailAuditTrail[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([status])
  @@index([currentAssigneeId])
  @@index([dueDate])
  @@map("mail_routings")
}

model MailParticipant {
  id        String   @id @default(uuid())
  routing   MailRouting @relation(fields: [routingId], references: [id], onDelete: Cascade)
  routingId String   @map("routing_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  role      ParticipantRole
  joinedAt  DateTime @default(now()) @map("joined_at")
  completedAt DateTime? @map("completed_at")

  @@unique([routingId, userId, role])
  @@index([routingId])
  @@index([userId])
  @@map("mail_participants")
}

model MailRoutingAction {
  id             String   @id @default(uuid())
  routing        MailRouting @relation(fields: [routingId], references: [id], onDelete: Cascade)
  routingId      String   @map("routing_id")
  actor          User     @relation(fields: [actorId], references: [id])
  actorId        String   @map("actor_id")
  actionType     MailActionType
  targetUser     User?    @relation("action_target", fields: [targetUserId], references: [id])
  targetUserId   String?  @map("target_user_id")
  previousStatus MailRoutingStatus? @map("previous_status")
  newStatus      MailRoutingStatus? @map("new_status")
  note           String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([routingId])
  @@index([actorId])
  @@index([actionType])
  @@index([createdAt])
  @@map("mail_routing_actions")
}

model MailComment {
  id              String   @id @default(uuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String   @map("document_id")
  routing         MailRouting @relation(fields: [routingId], references: [id], onDelete: Cascade)
  routingId       String   @map("routing_id")
  author          User     @relation(fields: [authorId], references: [id])
  authorId        String   @map("author_id")
  body            String   @db.Text
  parentComment   MailComment? @relation("comment_replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?  @map("parent_comment_id")
  replies         MailComment[] @relation("comment_replies")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([routingId])
  @@index([authorId])
  @@map("mail_comments")
}

model MailAuditTrail {
   id             String   @id @default(uuid())
   routing        MailRouting @relation(fields: [routingId], references: [id], onDelete: Cascade)
   routingId      String   @map("routing_id")
   actor          User     @relation(fields: [actorId], references: [id])
   actorId        String   @map("actor_id")
   action         String
   previousValues Json?    @map("previous_values")
   newValues      Json?    @map("new_values")
   ipAddress      String?  @map("ip_address")
   userAgent      String?  @map("user_agent")
   createdAt      DateTime @default(now()) @map("created_at")

   @@index([routingId])
   @@index([actorId])
   @@index([action])
   @@index([createdAt])
   @@map("mail_audit_trails")
}

model RoutingTemplate {
   id          String                @id @default(uuid())
   name        String
   description String?               @db.Text
   steps       RoutingTemplateStep[]
   isDefault   Boolean               @default(false) @map("is_default")
   createdAt   DateTime              @default(now()) @map("created_at")
   updatedAt   DateTime              @updatedAt @map("updated_at")

   @@index([isDefault])
   @@map("routing_templates")
}

model RoutingTemplateStep {
   id         String          @id @default(uuid())
   template   RoutingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
   templateId String          @map("template_id")
   order      Int
   role       ParticipantRole

   @@unique([templateId, order])
   @@index([templateId])
   @@map("routing_template_steps")
}

model AppRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_roles")
}

model RolePermission {
  id                String            @id @default(uuid())
  role              String            @unique
  canRead           Boolean           @default(true) @map("can_read")
  canCreate         Boolean           @default(false) @map("can_create")
  canEdit           Boolean           @default(false) @map("can_edit")
  badges            Badge[]
  confidentialities Confidentiality[]
  featurePermissions RoleFeaturePermission[]

  @@map("role_permissions")
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entity      String?
  entityId    String?  @map("entity_id")
  entityLabel String?  @map("entity_label")
  userId      String?  @map("user_id")
  userName    String?  @map("user_name")
  userRole    String?  @map("user_role")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RoleFeaturePermission {
  id               String         @id @default(uuid())
  feature          String
  canRead          Boolean        @default(false) @map("can_read")
  canCreate        Boolean        @default(false) @map("can_create")
  canEdit          Boolean        @default(false) @map("can_edit")
  canDelete        Boolean        @default(false) @map("can_delete")
  canSearch        Boolean        @default(false) @map("can_search")
  rolePermission   RolePermission @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)
  rolePermissionId String         @map("role_permission_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([rolePermissionId, feature])
  @@index([feature])
  @@map("role_feature_permissions")
}

